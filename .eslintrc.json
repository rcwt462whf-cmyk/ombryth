{
  "extends": ["next/core-web-vitals", "next/typescript"],
  "rules": {
    "@typescript-eslint/no-unused-vars": ["error", {
      "vars": "all",
      "args": "after-used",
      "argsIgnorePattern": "^_",
      "varsIgnorePattern": "^_|actionTypes",
      "caughtErrors": "none"
    }],
    "@typescript-eslint/no-empty-object-type": "off"
  }
}
